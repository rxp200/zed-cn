#!/bin/bash
set -euo pipefail

WASI_SDK_VERSION="34"
WASI_SDK_DIR="./target/wasi-sdk"
# Overridable so the download path can be exercised against a local server in tests.
WASI_SDK_BASE_URL="${WASI_SDK_BASE_URL:-https://github.com/WebAssembly/wasi-sdk/releases/download}"
WASI_SDK_ATTEMPTS="${WASI_SDK_ATTEMPTS:-5}"
WASI_SDK_RETRY_DELAY="${WASI_SDK_RETRY_DELAY:-10}"

installed_version=""
if [ -f "${WASI_SDK_DIR}/VERSION" ]; then
    installed_version=$(head -n 1 "${WASI_SDK_DIR}/VERSION" | tr -d '\r')
fi

if [ "${installed_version}" = "${WASI_SDK_VERSION}.0" ]; then
    echo "WASI SDK v${WASI_SDK_VERSION} already exists at ${WASI_SDK_DIR}"
    exit 0
fi

if [ -d "${WASI_SDK_DIR}" ]; then
    echo "WASI SDK at ${WASI_SDK_DIR} is version '${installed_version}', replacing with v${WASI_SDK_VERSION}..."
else
    echo "WASI SDK not found, downloading v${WASI_SDK_VERSION}..."
fi

# Determine OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Map architecture names to WASI SDK format
case $ARCH in
    x86_64)
        ARCH="x86_64"
        ;;
    arm64|aarch64)
        ARCH="arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# Map OS names to WASI SDK format
case $OS in
    darwin)
        OS="macos"
        ;;
    linux)
        OS="linux"
        ;;
    mingw*|msys*|cygwin*)
        OS="windows"
        ;;
    *)
        echo "Unsupported OS: $OS"
        exit 1
        ;;
esac

ARCHIVE_NAME="wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}"
WASI_SDK_URL="${WASI_SDK_BASE_URL}/wasi-sdk-${WASI_SDK_VERSION}/${ARCHIVE_NAME}.tar.gz"
ARCHIVE="./target/${ARCHIVE_NAME}.tar.gz"
EXTRACTION="./target/wasi-sdk-extract.$$"

cleanup() {
    rm -rf "${ARCHIVE}" "${EXTRACTION}"
}
trap cleanup EXIT

mkdir -p ./target

attempt=1
while true; do
    rm -rf "${ARCHIVE}" "${EXTRACTION}"
    echo "Downloading from: ${WASI_SDK_URL} (attempt ${attempt}/${WASI_SDK_ATTEMPTS})"
    # The release archive is downloaded and verified as a whole before anything is
    # promoted into place, so a truncated transfer fails this attempt instead of
    # producing a half-extracted SDK while all archives are discarded on failure.
    if curl -fL \
        --connect-timeout 30 \
        --max-time 1800 \
        --output "${ARCHIVE}" \
        "${WASI_SDK_URL}" \
        && gzip -t "${ARCHIVE}" \
        && mkdir -p "${EXTRACTION}" \
        && tar -xzf "${ARCHIVE}" -C "${EXTRACTION}"; then
        break
    fi

    if [ "${attempt}" -ge "${WASI_SDK_ATTEMPTS}" ]; then
        echo "Failed to download WASI SDK v${WASI_SDK_VERSION} after ${attempt} attempt(s): ${WASI_SDK_URL}" >&2
        exit 1
    fi
    attempt=$((attempt + 1))
    sleep "${WASI_SDK_RETRY_DELAY}"
done

EXTRACTED_DIR="${EXTRACTION}/${ARCHIVE_NAME}"
EXTRACTED_VERSION=""
if [ -f "${EXTRACTED_DIR}/VERSION" ]; then
    EXTRACTED_VERSION=$(head -n 1 "${EXTRACTED_DIR}/VERSION" | tr -d '\r')
fi

if [ "${EXTRACTED_VERSION}" != "${WASI_SDK_VERSION}.0" ]; then
    echo "Extracted archive has WASI SDK version '${EXTRACTED_VERSION}', expected '${WASI_SDK_VERSION}.0': ${EXTRACTED_DIR}" >&2
    exit 1
fi

rm -rf "${WASI_SDK_DIR}"
mv "${EXTRACTED_DIR}" "${WASI_SDK_DIR}"

echo "WASI SDK v${WASI_SDK_VERSION} installed successfully"
