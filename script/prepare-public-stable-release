#!/usr/bin/env python3

import argparse
import re
import subprocess
import sys
from pathlib import Path

from release_notes import changed_paths, make_review, resolve_previous, review_block, tag_key


PROTECTED_STABLE_PATHS = [".rules", "AGENTS.md"]
STABLE_OVERLAY_PATHS = [
    ".rules",
    "AGENTS.md",
    "Cargo.lock",
    "crates/zed/Cargo.toml",
    "crates/zed/RELEASE_CHANNEL",
]
PROTOCOL_AUDIT_PATHS = [
    "crates/proto",
    "crates/rpc",
    "crates/remote",
    "crates/remote_server",
    "crates/project",
    "crates/worktree",
    "crates/auto_update",
    "crates/terminal",
    "crates/lsp",
    "crates/dap",
    "crates/dap_adapters",
    "crates/debugger_tools",
    "crates/debugger_ui",
    "crates/project/src/debugger",
    "crates/agent",
]


def git(*arguments: str, capture: bool = True) -> str:
    result = subprocess.run(
        ["git", *arguments],
        check=False,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() if capture else ""
        raise RuntimeError(f"git {' '.join(arguments)} failed: {detail}")
    return result.stdout.strip() if capture else ""


def git_object(reference: str) -> str:
    return git("rev-parse", "--verify", f"{reference}^{{commit}}")


def replace_manifest_version(path: Path, version: str) -> None:
    text = path.read_text()
    updated, count = re.subn(
        r'(?m)^version\s*=\s*"[^"]+"',
        f'version = "{version}"',
        text,
        count=1,
    )
    if count != 1:
        raise RuntimeError(f"expected one package version in {path}")
    path.write_text(updated)


def replace_lockfile_zed_version(path: Path, version: str) -> None:
    text = path.read_text()
    package_pattern = re.compile(
        r'(?ms)(\[\[package\]\]\nname = "zed"\nversion = ")[^"]+("\n)'
    )
    updated, count = package_pattern.subn(rf"\g<1>{version}\g<2>", text, count=1)
    if count != 1:
        raise RuntimeError(f"expected one zed package entry in {path}")
    path.write_text(updated)


def changed_protocol_paths(stable_commit: str, source_commit: str) -> list[str]:
    output = git(
        "diff",
        "--name-only",
        stable_commit,
        source_commit,
        "--",
        *PROTOCOL_AUDIT_PATHS,
    )
    return output.splitlines() if output else []


def write_release_commit_message(source_commit: str, version: str, review: dict) -> Path:
    target = Path("target")
    target.mkdir(exist_ok=True)
    path = target / "stable-release-commit-message.md"
    path.write_text(
        f"""准备 Zed CN {version} Stable 发布

Zed-CN-Release-Notes:
## 本次更新

<!-- 用一段中文概括本次发布最重要的用户可见变化。 -->

## 功能

- <!-- 逐项描述新增功能、相关设置或操作方式；没有则写“无”。 -->

## 改进

- <!-- 逐项描述体验、性能、兼容性或汉化改进；没有则写“无”。 -->

## 错误修复

- <!-- 逐项描述修复的问题及用户影响；没有则写“无”。 -->

## 重大变更与通知

- <!-- 描述兼容性、键位、设置迁移、签名或远程开发注意事项；没有则写“无”。 -->
Zed-CN-Release-Notes-End

Public-Main-Source: {source_commit}

{review_block(review)}
"""
    )
    return path


def validate_generated_tree(source_commit: str, stable_commit: str) -> None:
    unexpected = git(
        "diff",
        "--name-only",
        source_commit,
        "--",
        ":(exclude)" + STABLE_OVERLAY_PATHS[0],
        ":(exclude)" + STABLE_OVERLAY_PATHS[1],
        ":(exclude)" + STABLE_OVERLAY_PATHS[2],
        ":(exclude)" + STABLE_OVERLAY_PATHS[3],
        ":(exclude)" + STABLE_OVERLAY_PATHS[4],
    )
    if unexpected:
        raise RuntimeError(
            "generated Stable tree differs from public main outside the approved "
            f"Stable overlay paths:\n{unexpected}"
        )

    for path in PROTECTED_STABLE_PATHS:
        generated_blob = git("rev-parse", f":{path}")
        stable_blob = git("rev-parse", f"{stable_commit}:{path}")
        if generated_blob != stable_blob:
            raise RuntimeError(f"{path} does not match the official Stable baseline")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Generate a public Stable release tree from the complete public main tree "
            "while retaining the official Stable version, channel, and protected rules."
        )
    )
    parser.add_argument("--source-ref", default="github/main")
    parser.add_argument("--stable-tag", required=True)
    parser.add_argument("--release-tag", required=True)
    parser.add_argument("--previous-release", help="override the previous published Release")
    parser.add_argument("--release-repository", default="rxp200/zed-cn")
    parser.add_argument(
        "--remote-review-approved",
        metavar="SOURCE_SHA:STABLE_SHA",
        help="resume only after reporting remote changes and receiving explicit user approval for these exact commits",
    )
    arguments = parser.parse_args()

    root = Path(git("rev-parse", "--show-toplevel"))
    if Path.cwd().resolve() != root.resolve():
        raise RuntimeError("run this script from the repository root")
    if git("status", "--porcelain"):
        raise RuntimeError("the Stable worktree must be clean before generation")

    tag_match = re.fullmatch(r"v(\d+\.\d+\.\d+)", arguments.stable_tag)
    if tag_match is None:
        raise RuntimeError("--stable-tag must be a formal Stable tag such as v1.17.2")
    version = tag_match.group(1)
    if tag_key(arguments.release_tag)[:3] != tuple(map(int, version.split("."))):
        raise RuntimeError("release tag version must match --stable-tag")
    source_commit = git_object(arguments.source_ref)
    stable_commit = git_object(arguments.stable_tag)

    stable_channel = git("show", f"{stable_commit}:crates/zed/RELEASE_CHANNEL").strip()
    stable_manifest = git("show", f"{stable_commit}:crates/zed/Cargo.toml")
    stable_version_match = re.search(r'(?m)^version\s*=\s*"([^"]+)"', stable_manifest)
    if stable_channel != "stable" or stable_version_match is None:
        raise RuntimeError("the selected official tag is not a valid Stable source")
    if stable_version_match.group(1) != version:
        raise RuntimeError(
            f"tag version {version} does not match its Zed manifest version "
            f"{stable_version_match.group(1)}"
        )

    if subprocess.run(
        ["git", "merge-base", "--is-ancestor", stable_commit, "HEAD"], check=False
    ).returncode != 0:
        raise RuntimeError(
            "the current Stable branch must descend from the selected official Stable tag"
        )

    protocol_paths = changed_protocol_paths(stable_commit, source_commit)
    if protocol_paths:
        print("Remote/API differences requiring review after GitHub main synchronization:")
        for path in protocol_paths:
            print(f"  {path}")
        approval = f"{source_commit}:{stable_commit}"
        if arguments.remote_review_approved != approval:
            print(
                "Pause before generating the Stable tree. Inspect the complete diffs, report "
                "affected files/symbols, wire/API and runtime changes, official Stable server "
                "compatibility (compatible/incompatible/uncertain) and evidence to the user. "
                "Do not infer incompatibility from a path difference alone. "
                f"Only after explicit approval resume with --remote-review-approved {approval}",
                file=sys.stderr,
            )
            return 2
        print("Resuming for the exact source/baseline pair after recorded user approval; "
              "this option is not proof of compatibility.")
    elif arguments.remote_review_approved:
        raise RuntimeError("remote approval supplied but no matching remote differences exist")

    previous_release, previous_commit = resolve_previous(
        arguments.release_tag, arguments.release_repository, arguments.previous_release
    )
    git("read-tree", "--reset", "-u", source_commit, capture=False)
    git("checkout", stable_commit, "--", *PROTECTED_STABLE_PATHS, capture=False)

    Path("crates/zed/RELEASE_CHANNEL").write_text("stable\n")
    replace_manifest_version(Path("crates/zed/Cargo.toml"), version)
    replace_lockfile_zed_version(Path("Cargo.lock"), version)
    git("add", "--all", capture=False)

    validate_generated_tree(source_commit, stable_commit)
    print(f"Prepared Stable tree from public main: {source_commit}")
    print(f"Official Stable baseline: {arguments.stable_tag} ({stable_commit})")
    review = make_review(arguments.release_tag, previous_release["tag_name"],
                         previous_commit, changed_paths(previous_commit, ":index"))
    commit_message_path = write_release_commit_message(source_commit, version, review)
    context_path = Path("target/stable-release-review-context.md")
    previous_message = git("show", "-s", "--format=%B", previous_commit)
    previous_source = re.search(r"(?m)^Public-Main-Source: ([0-9a-f]{40})$", previous_message)
    history_base = previous_source.group(1) if previous_source else previous_commit
    context_path.write_text(
        f"# {previous_release['tag_name']} → {arguments.release_tag}\n\n"
        f"Baseline: {previous_commit}\n\n## Previous release notes\n\n"
        + (previous_release.get("body") or "")
        + "\n\n## Actual staged changes\n\n```\n"
        + git("diff", "--cached", "--stat", previous_commit)
        + "\n```\n\n## Commit clues (not a substitute for the diff)\n\n```\n"
        + git("log", "--format=%h %s", f"{history_base}..{source_commit}")
        + "\n```\n\nReview every path in the commit message. included/merged detail must quote "
        "an exact release-note bullet; internal detail must explain exclusion. "
        "A file may contain several changes: inspect the full diff, not only its name.\n"
    )
    print(f"Frozen baseline: {previous_release['tag_name']} ({previous_commit})")
    print(f"Review context: {context_path}")
    print(f"Release identity: stable/{version}")
    print("The index contains the complete generated release tree.")
    print(f"Write detailed Chinese release notes in {commit_message_path}, then commit with:")
    print(f"  python3 script/release_notes.py --message {commit_message_path} --target :index --release-tag {arguments.release_tag}")
    print(f"  git commit -F {commit_message_path}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
