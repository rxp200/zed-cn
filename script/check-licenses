#!/usr/bin/env bash

set -euo pipefail

# This component is vendored third-party code. Its original license files must
# remain regular files rather than links to Zed's first-party license texts.
declare -A VENDORED_LICENSES=(
    ["crates/alacritty_terminal"]="LICENSE-APACHE LICENSE-MIT"
)

check_manifest_for_agpl () {
    local cargo_toml="$1"

    if grep -Eiq '(agpl|affero)' "$cargo_toml"; then
        echo "Error: $cargo_toml references an AGPL license. First-party crates must use LICENSE-GPL or LICENSE-APACHE."
        exit 1
    fi

    if grep -Eiq '^[[:space:]]*license-file[[:space:]]*=' "$cargo_toml"; then
        echo "Error: $cargo_toml uses license-file. First-party crates must declare LICENSE-GPL or LICENSE-APACHE via the license field and symlink."
        exit 1
    fi
}

check_no_agpl_license_file () {
    if [[ -e "LICENSE-AGPL" || -L "LICENSE-AGPL" ]]; then
        echo "Error: LICENSE-AGPL exists. First-party code must use LICENSE-GPL or LICENSE-APACHE."
        exit 1
    fi

    while IFS= read -r -d '' license_file; do
        if [[ -e "$license_file" || -L "$license_file" ]]; then
            echo "Error: $license_file exists. First-party crates must use LICENSE-GPL or LICENSE-APACHE."
            exit 1
        fi
    done < <(git ls-files -z -- "*/LICENSE-AGPL")
}

check_symlink_target () {
    local symlink_path="$1"
    local license_name="$2"

    local target
    target=$(readlink "$symlink_path")

    local dir
    dir=$(dirname "$symlink_path")
    local depth
    depth=$(echo "$dir" | tr '/' '\n' | wc -l)
    local expected_prefix=""
    for ((i = 0; i < depth; i++)); do
        expected_prefix="../$expected_prefix"
    done
    local expected_target="${expected_prefix}${license_name}"

    if [[ "$target" != "$expected_target" ]]; then
        echo "Error: $symlink_path points to '$target' but should point to '$expected_target'"
        exit 1
    fi

    if [[ ! -e "$symlink_path" ]]; then
        echo "Error: $symlink_path is a broken symlink (target '$target' does not exist)"
        exit 1
    fi
}

check_first_party_license () {
    local dir="$1"
    local manifest="$dir/Cargo.toml"
    local declared_license=""
    local expected_file=""

    declared_license=$(awk -F '"' '/^[[:space:]]*license[[:space:]]*=/ { print $2; exit }' "$manifest")
    case "$declared_license" in
        GPL-3.0-or-later) expected_file="LICENSE-GPL" ;;
        Apache-2.0|"MIT OR Apache-2.0") expected_file="LICENSE-APACHE" ;;
        "")
            if [[ -L "$dir/LICENSE-GPL" && ! -e "$dir/LICENSE-APACHE" ]]; then
                expected_file="LICENSE-GPL"
            elif [[ -L "$dir/LICENSE-APACHE" && ! -e "$dir/LICENSE-GPL" ]]; then
                expected_file="LICENSE-APACHE"
            else
                echo "Error: $manifest has no license field and its component license is ambiguous."
                exit 1
            fi
            ;;
        *)
            echo "Error: $manifest must declare an approved first-party GPL-3.0-or-later or Apache-2.0 license."
            exit 1
            ;;
    esac

    for license_file in LICENSE-GPL LICENSE-APACHE; do
        if [[ -e "$dir/$license_file" || -L "$dir/$license_file" ]]; then
            if [[ "$license_file" != "$expected_file" ]]; then
                echo "Error: $dir/$license_file does not match '$declared_license' in $manifest."
                exit 1
            fi
            if [[ ! -L "$dir/$license_file" ]]; then
                echo "Error: $dir/$license_file exists but is not a symlink."
                exit 1
            fi
            check_symlink_target "$dir/$license_file" "$license_file"
            return 0
        fi
    done

    echo "Error: $dir does not contain the expected $expected_file symlink"
    exit 1
}

check_vendored_license () {
    local dir="$1"
    local expected_files=${VENDORED_LICENSES[$dir]}

    for license_file in $expected_files; do
        if [[ ! -f "$dir/$license_file" || -L "$dir/$license_file" ]]; then
            echo "Error: vendored component $dir must preserve $license_file as a regular file."
            exit 1
        fi
        if [[ -n "$(git status --porcelain=v1 -- "$dir/$license_file")" ]]; then
            echo "Error: vendored license $dir/$license_file has uncommitted modifications."
            exit 1
        fi
    done
}

check_no_agpl_license_file

while IFS= read -r -d '' cargo_toml; do
    check_manifest_for_agpl "$cargo_toml"

    if [[ "$cargo_toml" == */Cargo.toml ]]; then
        dir=$(dirname "$cargo_toml")
        if [[ -n "${VENDORED_LICENSES[$dir]:-}" ]]; then
            check_vendored_license "$dir"
        else
            check_first_party_license "$dir"
        fi
    fi
done < <(git ls-files -z -- "Cargo.toml" "**/Cargo.toml")

echo "check-licenses succeeded"
